# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing bearer session tokens (auto-generated in-memory if omitted).
SESSION_SECRET=

# ADMIN_PASSCODE: Optional server-side admin passcode. If omitted, use the first-run admin setup form in the UI.
ADMIN_PASSCODE=

# SMTP Configuration for Real-Time Due-Date Email Reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pustaka Aksara <noreply@pustaka-aksara.id>"
